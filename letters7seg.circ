unnel"><a name="facing" val="west" /><a name="label" val="C" /></comp><wire from="(500,250)" to="(560,250)" /><comp lib="0" loc="(560,270)" name="Tunnel"><a name="facing" val="west" /><a name="label" val="D" /></comp><wire from="(500,270)" to="(560,270)" /><comp lib="0" loc="(560,290)" name="Tunnel"><a name="facing" val="west" /><a name="label" val="E" /></comp><wire from="(500,290)" to="(560,290)" /><comp lib="0" loc="(560,310)" name="Tunnel"><a name="facing" val="west" /><a name="label" val="F" /></comp><wire from="(500,310)" to="(560,310)" /><comp lib="0" loc="(560,330)" name="Tunnel"><a name="facing" val="west" /><a name="label" val="G" /></comp><wire from="(500,330)" to="(560,330)" /><comp lib="6" loc="(760,250)" name="7-Segment Display"><a name="labelloc" val="east" /><a name="decimalPoint" val="false" /><a name="label" val="Letter" /></comp><comp lib="0" loc="(760,150)" name="Tunnel"><a name="facing" val="south" /><a name="label" val="G" /></comp><wire from="(760,150)" to="(760,250)" /><comp lib="0" loc="(770,180)" name="Tunnel"><a name="facing" val="south" /><a name="label" val="F" /></comp><wire from="(770,180)" to="(770,250)" /><comp lib="0" loc="(780,120)" name="Tunnel"><a name="facing" val="south" /><a name="label" val="A" /></comp><wire from="(780,120)" to="(780,250)" /><comp lib="0" loc="(790,90)" name="Tunnel"><a name="facing" val="south" /><a name="label" val="B" /></comp><wire from="(790,90)" to="(790,250)" /><comp lib="0" loc="(760,340)" name="Tunnel"><a name="facing" val="north" /><a name="label" val="E" /></comp><wire from="(760,310)" to="(760,340)" /><comp lib="0" loc="(770,370)" name="Tunnel"><a name="facing" val="north" /><a name="label" val="D" /></comp><wire from="(770,310)" to="(770,370)" /><comp lib="0" loc="(780,400)" name="Tunnel"><a name="facing" val="north" /><a name="label" val="C" /></comp><wire from="(780,310)" to="(780,400)" /></circuit><vhdl appearance="logisim_evolution" name="letters7seg">library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity letters7seg is
    port (
        sel : in STD_LOGIC_VECTOR(2 downto 0);
        sa, sb, sc, sd, se, sf, sg : out STD_LOGIC
    );
end letters7seg;

architecture Behavioral of letters7seg is
    -- Segment order: a b c d e f g; 1 = ON.
    signal segments : STD_LOGIC_VECTOR(6 downto 0);
begin
    with sel select
        segments &lt;= "1111101" when "000", -- a
                    "0011111" when "001", -- b
                    "0001101" when "010", -- c
                    "0111101" when "011", -- d
                    "1000111" when "100", -- f
                    "1111011" when "101", -- g
                    "0000000" when others;

    sa &lt;= segments(6);
    sb &lt;= segments(5);
    sc &lt;= segments(4);
    sd &lt;= segments(3);
    se &lt;= segments(2);
    sf &lt;= segments(1);
    sg &lt;= segments(0);
end Behavioral;</vhdl></project>